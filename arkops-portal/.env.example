# Base URL of the kiosk-gateway service (OpenClaw remote-browser login),
# per docs/pdd-login-method2.md. Leave unset in local/demo dev — the
# Pinduoduo store-connect step will surface a "gateway not configured" error
# instead of simulating success.
VITE_KIOSK_GATEWAY_URL=https://your-gateway-host:8090
