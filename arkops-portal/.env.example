# Kiosk-gateway service (OpenClaw remote-browser login), per docs/pdd-login-method2.md.
# Leave unset in local/demo dev — the Pinduoduo store-connect step will surface a
# "gateway not configured" error instead of simulating success.
#
# Production: point both at the real gateway origin.
#   VITE_KIOSK_GATEWAY_URL=https://your-gateway-host:8090
#
# Local dev (recommended): route /api through the Vite dev proxy to avoid CORS and the
# gateway's self-signed cert, while the streaming iframe still loads direct from the
# gateway. Set these in .env.local (gitignored):
#   VITE_KIOSK_GATEWAY_URL=/gateway                          # /api/* → Vite proxy (see vite.config.ts)
#   VITE_KIOSK_GATEWAY_STREAM_URL=https://your-gateway-host:8090  # iframe direct + proxy target
VITE_KIOSK_GATEWAY_URL=https://your-gateway-host:8090
# VITE_KIOSK_GATEWAY_STREAM_URL=https://your-gateway-host:8090
